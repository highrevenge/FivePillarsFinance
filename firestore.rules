rules_version = '2';

// Firestore Security Rules for 5-Pillar Finance
// -----------------------------------------------
// Each signed-in user can only read/write their OWN profile doc
// (users/{their uid}) and their OWN dashboard doc (dashboards/{their uid}).
// Nobody can read or write anyone else's data, and nobody signed out can
// touch anything at all.
//
// To apply: Firebase Console -> your project -> Firestore Database ->
// Rules tab -> replace everything with this -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /dashboards/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else stays locked by default (Firestore denies anything
    // not explicitly allowed above).
  }
}
